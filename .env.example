# Postgres (Neon or any Postgres 15+). Leave unset locally to use the embedded PGlite database in ./.data
DATABASE_URL=
# Direct (non-pooled) connection used by migrations during the build
DATABASE_URL_UNPOOLED=

# Long random string. Encrypts integration credentials at rest. Required in production.
SECRET_KEY=
# Vercel Cron sends this as a Bearer token to /api/cron
CRON_SECRET=

# Optional: enables the AI assistant, briefings and the WhatsApp AI agent
ANTHROPIC_API_KEY=

# Optional: public base URL used in invitation, webhook and form links
APP_URL=
# Optional: WhatsApp / Meta Graph API version
WHATSAPP_GRAPH_VERSION=v23.0
